# Local development configuration (copy to .env or export in your shell; never commit real secrets)
DB_URL=jdbc:postgresql://localhost:5432/tubasmart
DB_USERNAME=postgres
DB_PASSWORD=postgres
# REQUIRED. Generate with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:4200
SERVER_PORT=8080
# First admin, created only if the users table is empty
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-please
